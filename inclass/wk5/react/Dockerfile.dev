# Alternative to a local Node install for the wk5 React workshop -- see DOCKER.md.
#
# Debian-based, not Alpine: Tailwind v4's native binary (@tailwindcss/oxide)
# ships prebuilt for glibc, and Alpine's musl libc is a real, easy-to-hit trap
# for exactly the students this file exists for. Costs a bigger image; buys no
# "works on my machine, not in the container" surprise.
FROM node:22-bookworm-slim

WORKDIR /app

# Installed once, at build time, from the lockfile everyone already has.
# `docker compose watch` syncs source edits in below -- it never touches
# node_modules, so this layer is reused across a whole day of teaching.
COPY package.json package-lock.json ./
RUN npm ci

# A first copy of the project, so the dev server has something to serve before
# the first watch sync happens. Excludes node_modules/dist -- see .dockerignore.
COPY . .

EXPOSE 5173

# Called directly, not through `npm run dev`: that script hardcodes
# --host 127.0.0.1 for the plain local workflow, which would be unreachable
# from outside this container. --host 0.0.0.0 is the container-only override.
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]
